# Health (DS-43).

config SS_HEALTH
	bool "Health"
	depends on SS_MESSAGES
	select SS_NVM
	select HWINFO
	select WATCHDOG if $(dt_alias_enabled,watchdog0)
	# Each app's stack high-water mark (DS-44): stacks are filled with a
	# known pattern when each thread is created, and health finds each
	# app's thread by name.
	select INIT_STACKS
	select THREAD_STACK_INFO
	select THREAD_MONITOR
	select THREAD_NAME
	help
	  Watches every app's progress through the frame manager's report,
	  stops a stalled app's wakeups, restarts the ones whose re-enable
	  policy is AUTO, reports the app threads' stack high-water marks, and
	  is the only feeder of the hardware watchdog.

if SS_HEALTH

config SS_WATCHDOG_TIMEOUT_MS
	int "Hardware watchdog timeout (ms)"
	default 3000
	range 1500 30000
	help
	  Health feeds the watchdog once a major frame (1 s). 3 s tolerates
	  one late or missed feed and resets within a few seconds of a hang
	  (DS-43).

config SS_REENABLE_COOLDOWN_FRAMES
	int "Major frames before health restarts an AUTO app"
	default 10
	range 1 3600
	help
	  An app whose re-enable policy is REENABLE_AUTO is started again this
	  many major frames after health stopped it for a stall, up to its
	  auto_retry_cap times; after that only the ground restarts it
	  (DS-43).

config SS_STACK_MARGIN_BYTES
	int "Stack bytes an app should never use (bytes)"
	default 256
	range 0 65536
	help
	  Health sets stack_low in its housekeeping when any app's thread has
	  had less than this much of its stack unused (DS-44): its stack size
	  in the resource map should grow before it overflows.

config SS_RESET_LOOP_RUN_MINUTES
	int "A run shorter than this counts toward a reset loop (minutes)"
	default 10
	range 1 1440
	help
	  A run that ends sooner than this, by its last checkpoint, is a
	  short run (DS-44). Ten minutes is long enough for every app to have
	  run many major frames, so a fault that resets soon after boot is
	  caught.

config SS_RESET_LOOP_SAFE_RUNS
	int "Short runs in a row before health asks for safe mode"
	default 3
	range 2 16
	help
	  At this many short runs in a row, health asks the mode manager for
	  safe mode with reason reset_loop (DS-44).

config SS_RESET_LOOP_STOP_RUNS
	int "Short runs in a row before health stops every app that isn't protected"
	default 6
	range 2 16
	help
	  If the loop goes on, in safe mode too, health also stops every app
	  it watches that isn't protected, until the ground starts them again
	  (DS-44). At most 16, the boot log's length. Must be at least
	  SS_RESET_LOOP_SAFE_RUNS.

endif # SS_HEALTH
