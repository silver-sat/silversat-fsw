/*
 * FRAM and its mirror are fakes (tests/fakes/) that the test fills before
 * the apps start, as if the spacecraft had just reset. The radio's UART is
 * Zephyr's emulated UART; nothing is sent over it here.
 */

/ {
	aliases {
		fram = &fake_fram;
		nvm-mirror = &fake_mirror;
		radio-uart = &radio_uart_emul;
	};

	fake_fram: fake-fram {
		compatible = "silversat,fake-fram";
		status = "okay";
		size = <DT_SIZE_K(32)>;
	};

	fake_mirror: fake-mirror {
		compatible = "silversat,fake-retained-mem";
		status = "okay";
		size = <DT_SIZE_K(4)>;
	};

	radio_uart_emul: radio-uart-emul {
		compatible = "zephyr,uart-emul";
		status = "okay";
		current-speed = <19200>;
	};
};
