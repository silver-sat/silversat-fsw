/*
 * Emulated SPI bus for driver tests.
 *
 * The mag@0 child node returns with the driver. A child on this bus needs a
 * real device object (from DEVICE_DT_INST_DEFINE in the driver), or the
 * controller's child table fails to link.
 */

/ {
	test {
		#address-cells = <1>;
		#size-cells = <1>;

		test_spi: spi@40000000 {
			compatible = "zephyr,spi-emul-controller";
			status = "okay";
			reg = <0x40000000 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <4000000>;
		};
	};
};