# Generated message definitions (DS-60, DS-61, DS-68).

config SS_MESSAGES
	bool "Generated message types and zbus channels"
	select ZBUS
	select ZBUS_MSG_SUBSCRIBER
	help
	  Run the message generator on messages/*.yaml at build time and
	  compile the zbus channels it defines. Apps include msg/<app>.h
	  and msg/common.h from the generated output.

if SS_MESSAGES

config SS_CMD_ROUTES
	bool "Generated command routing"
	select SS_CMD_TEXT
	help
	  Compile the generated cmd_routes.c, which decodes ground command
	  text and publishes it to the target app (DS-50 stages 6 and 7).
	  Command ingest selects this.

# No dynamic allocation after init: zbus takes message buffers from a
# fixed pool, not the heap.
configdefault ZBUS_PREFER_DYNAMIC_ALLOCATION
	default n

# Every publish on every channel takes one buffer, so each buffer must
# hold the largest message on any channel. The generated channel files
# fail the build if a message is larger.
configdefault ZBUS_MSG_SUBSCRIBER_NET_BUF_STATIC_DATA_SIZE
	default 32

# The pool must hold every queued copy plus one buffer per thread that
# publishes. include/silversat/resource_map.h computes the number and
# fails the build, saying what to set here, if this is too small (DS-07).
configdefault ZBUS_MSG_SUBSCRIBER_NET_BUF_POOL_SIZE
	default 16

endif # SS_MESSAGES
