{% import "_macros.j2" as m %}
{{ m.banner("messages/common.yaml and the app definitions") }}

#ifndef SILVERSAT_MSG_COMMON_H_
#define SILVERSAT_MSG_COMMON_H_

#include <stdbool.h>
#include <stdint.h>

#include <zephyr/zbus/zbus.h>

/** App identifiers, from the id in each apps/<app>.yaml. */
enum app_id {
{% for app in defs.apps %}
	{{ app.id_constant }} = {{ app.id }},
{% endfor %}
};

/*
 * How many apps are defined, how many of them the frame manager drives, and
 * the largest app id. The resource map sizes the zbus buffer pool and the
 * per-app attribute table from these (DS-07).
 */
#define APP_COUNT {{ defs.apps | length }}
#define APP_WAKEUP_COUNT {{ defs.wakeup_apps | length }}
#define APP_ID_MAX {{ defs.apps | map(attribute="id") | max }}
{% for e in defs.enums %}

{{ e.description | comment }}
enum {{ e.name }} {
{% for v in e.values %}
{% if v.description %}
{{ v.description | comment("\t") }}
{% endif %}
	{{ v.constant }} = {{ v.value }},
{% endfor %}
};

/** The largest enum {{ e.name }} value, for sizing arrays indexed by it. */
#define {{ e.max_constant }} {{ e.max_value }}
{% endfor %}
{% for s in defs.structs %}

{{ s.description | comment }}
struct {{ s.name }} {
{{ m.struct_body(s.fields) -}}
};
{% endfor %}

/*
 * Every app's status channel, the wakeup channel of every app the frame
 * manager drives, and every data channel. They carry only the common types
 * above, so they are declared here: other apps reach them without including
 * the owner's header (DS-68). Only the owner publishes them.
 */
{% for app in defs.apps %}
ZBUS_CHAN_DECLARE({{ app.status_chan }});
{% if app.wakeup %}
ZBUS_CHAN_DECLARE({{ app.wakeup_chan }});
{% endif %}
{% for d in app.data_channels %}
ZBUS_CHAN_DECLARE({{ d.name }}); /* owned by {{ app.name }} */
{% endfor %}
{% endfor %}

#endif /* SILVERSAT_MSG_COMMON_H_ */
