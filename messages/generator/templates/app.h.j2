{% import "_macros.j2" as m %}
{% set guard = "SILVERSAT_MSG_" ~ app.name | upper ~ "_H_" %}
{{ m.banner(app.source) }}

#ifndef {{ guard }}
#define {{ guard }}

#include <stdbool.h>
#include <stdint.h>

#include <zephyr/zbus/zbus.h>
{% if app.events %}

#include "silversat/event.h"
{% endif %}

#include "msg/common.h"
{% if app.commands %}

/** Command identifiers, carried in struct {{ app.cmd_struct }}. */
enum {{ app.cmd_id_enum }} {
{% for c in app.commands %}
	{{ c.constant }} = {{ c.id }},
{% endfor %}
};

/* The words for this app and its commands in command text (DS-50). */
#define {{ app.name_constant }} "{{ app.name }}"
{% for c in app.commands %}
#define {{ c.constant }}_NAME "{{ c.name }}"
{% endfor %}
{% endif %}
{% for c in app.commands_with_args %}

{{ c.description | comment }}
struct {{ c.struct }} {
{{ m.struct_body(c.fields) -}}
};
{% endfor %}

/** A command for {{ app.name }}, as published on {{ app.cmd_chan }}. */
struct {{ app.cmd_struct }} {
{% if app.commands %}
	/** enum {{ app.cmd_id_enum }} */
{% else %}
	/** No commands are defined yet. */
{% endif %}
	uint16_t id;
{% if app.commands_with_args %}
	/** The member named after the command in id. */
	union {
{% for c in app.commands_with_args %}
		struct {{ c.struct }} {{ c.name }};
{% endfor %}
	} args;
{% endif %}
};

{{ app.housekeeping.description | comment }}
struct {{ app.hk_struct }} {
{{ m.struct_body(app.housekeeping.fields) -}}
};

/**
 * One buffer that can hold any message {{ app.name }} receives. Pass it to
 * zbus_sub_wait_msg(). A union is aligned for every member, so reading a
 * struct out of it is safe; casting a byte array to a struct pointer is a
 * misaligned access that UBSan reports.
 */
union {{ app.msg_union }} {
	struct {{ app.cmd_struct }} cmd; /* {{ app.cmd_chan }} */
{% if app.wakeup %}
	struct frame_tick tick; /* {{ app.wakeup_chan }} */
{% endif %}
};

ZBUS_CHAN_DECLARE({{ app.cmd_chan }});
ZBUS_CHAN_DECLARE({{ app.hk_chan }});
{% if app.sends %}

/*
 * Internal commands {{ app.name }} sends (DS-68), declared under sends: in
 * {{ app.source }}. Each publishes to the target app's command channel
 * without waiting. Returns 0 if sent; -EBUSY if {{ app.name }} already has
 * CMD_MAX_PENDING commands that app hasn't handled (try again next frame);
 * -EIO if the publish failed. See silversat/cmd_deliver.h.
 */
{% for send in app.sends %}

{{ (send.target.name ~ " " ~ send.command.name ~ ": " ~ send.command.description) | comment }}
int {{ send.function }}({{ send.params }});
{% endfor %}
{% endif %}

{% if app.events %}

/** Event numbers, unique within {{ app.name }}. Never reuse one (DS-62). */
enum {{ app.event_id_enum }} {
{% for e in app.events %}
	{{ e.constant }} = {{ e.id }},
{% endfor %}
};

/*
 * Events {{ app.name }} raises (DS-10), declared under events: in
 * {{ app.source }}. Each queues the event for the downlink without waiting;
 * a full queue drops it, and the drop is counted (silversat/event.h).
 * met_ms is the MET of the current tick (DS-25).
 */
{% macro arg_value(a) %}{% if a.type == "app" %}app_name((uint8_t){{ a.name }}){% elif a.type == "int32" %}NULL{% else %}{{ a.type }}_name((uint32_t){{ a.name }}){% endif %}{% endmacro %}
{% for e in app.events %}

{{ (e.name ~ " (" ~ e.severity ~ "): " ~ e.description) | comment }}
static inline void {{ e.function }}({{ e.params }})
{
	const struct event event = {
		.met_ms = met_ms,
		.app = {{ app.id_constant }},
		.severity = {{ defs.severity_constants[e.severity] }},
		.id = {{ e.constant }},
		.arg0 = {{ e.args[0].name if e.args | length > 0 else 0 }},
		.arg1 = {{ e.args[1].name if e.args | length > 1 else 0 }},
	};
	const struct event_text text = {
		.name = "{{ e.name }}",
{% for a in e.args %}
		.arg_names[{{ loop.index0 }}] = "{{ a.name }}",
		.arg_values[{{ loop.index0 }}] = {{ arg_value(a) }},
{% endfor %}
	};

	event_emit(&event, &text);
}
{% endfor %}
{% endif %}

/*
 * Also owned by {{ app.name }}, and declared in msg/common.h:
 *   {{ app.status_chan }}
{% if app.wakeup %}
 *   {{ app.wakeup_chan }}
{% endif %}
{% for d in app.data_channels %}
 *   {{ d.name }}
{% endfor %}
 */

#endif /* {{ guard }} */
