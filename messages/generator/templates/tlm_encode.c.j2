{% import "_macros.j2" as m %}
{{ m.banner("the app definitions in messages/apps/") }}

/*
 * Housekeeping encoders for the downlink (DS-61, DS-64). Each app's latest
 * housekeeping is read from its channel and written field by field,
 * little-endian, with no padding: never a copy of the struct, whose layout
 * differs between the M4 and native_sim. Only telemetry output calls
 * tlm_encode_hk(); this file includes every app's header so that telemetry
 * output itself never has to (DS-68).
 */

#include <errno.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <string.h>

#include <zephyr/sys/byteorder.h>
#include <zephyr/sys/util.h>
#include <zephyr/zbus/zbus.h>

#include "msg/common.h"
{% for app in defs.apps %}
#include "msg/{{ app.name }}.h"
{% endfor %}
#include "silversat/tlm_encode.h"

{% if "f32" in defs.hk_wire_kinds %}

/* A float, as its IEEE 754 bits, least significant byte first. */
static void put_f32(float value, uint8_t *out)
{
	uint32_t bits;

	memcpy(&bits, &value, sizeof(bits));
	sys_put_le32(bits, out);
}
{% endif %}
{% if "f64" in defs.hk_wire_kinds %}

/* A double, as its IEEE 754 bits, least significant byte first. */
static void put_f64(double value, uint8_t *out)
{
	uint64_t bits;

	memcpy(&bits, &value, sizeof(bits));
	sys_put_le64(bits, out);
}
{% endif %}
{% macro put(f, offset) %}
{% if f.wire_kind == "bool" %}
	out[{{ offset }}] = hk.{{ f.name }} ? 1 : 0;
{% elif f.wire_kind == "byte" %}
	out[{{ offset }}] = (uint8_t)hk.{{ f.name }};
{% elif f.wire_kind == "le16" %}
	sys_put_le16((uint16_t)hk.{{ f.name }}, &out[{{ offset }}]);
{% elif f.wire_kind == "le32" %}
	sys_put_le32((uint32_t)hk.{{ f.name }}, &out[{{ offset }}]);
{% elif f.wire_kind == "le64" %}
	sys_put_le64((uint64_t)hk.{{ f.name }}, &out[{{ offset }}]);
{% elif f.wire_kind == "f32" %}
	put_f32(hk.{{ f.name }}, &out[{{ offset }}]);
{% else %}
	put_f64(hk.{{ f.name }}, &out[{{ offset }}]);
{% endif %}
{% endmacro %}
{% for app in defs.apps %}

/* {{ app.hk_struct }}: {{ app.housekeeping.wire_size }} bytes on the downlink. */
static int encode_{{ app.name }}(uint8_t *out)
{
	struct {{ app.hk_struct }} hk;

	if (zbus_chan_read(&{{ app.hk_chan }}, &hk, K_NO_WAIT) != 0) {
		return -EBUSY;
	}
{% for f, offset in app.housekeeping.wire_layout %}
{{ put(f, offset) -}}
{% endfor %}
	return {{ app.housekeeping.wire_size }};
}
{% endfor %}

struct hk_source {
	uint8_t app;
	uint8_t size;
	int (*encode)(uint8_t *out);
};

static const struct hk_source sources[] = {
{% for app in defs.apps %}
	{{ "{" }}{{ app.id_constant }}, {{ app.housekeeping.wire_size }}, encode_{{ app.name }}{{ "}" }},
{% endfor %}
};

const uint8_t tlm_hk_apps[] = {
{% for app in defs.apps %}
	{{ app.id_constant }},
{% endfor %}
};
const size_t tlm_hk_app_count = ARRAY_SIZE(tlm_hk_apps);

int tlm_encode_hk(uint8_t app, int64_t met_ms, uint8_t *out, size_t out_size)
{
	for (size_t i = 0; i < ARRAY_SIZE(sources); i++) {
		const struct hk_source *source = &sources[i];
		int len;

		if (source->app != app) {
			continue;
		}
		if (out_size < TLM_HK_HEADER_LEN + (size_t)source->size) {
			return -ENOSPC;
		}
		out[0] = TLM_KIND_HK;
		out[1] = app;
		sys_put_le64((uint64_t)met_ms, &out[2]);
		len = source->encode(&out[TLM_HK_HEADER_LEN]);
		return len < 0 ? len : TLM_HK_HEADER_LEN + len;
	}
	return -ENOENT;
}
