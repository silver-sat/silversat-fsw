{% import "_macros.j2" as m %}
{{ m.banner(app.source) }}

#include <zephyr/sys/util.h>
#include <zephyr/zbus/zbus.h>

#include "msg/{{ app.name }}.h"

/*
 * The channels {{ app.name }} owns (DS-14, DS-68). Each is defined with no
 * observers; the app adds itself with ZBUS_CHAN_ADD_OBS.
 */

ZBUS_CHAN_DEFINE({{ app.cmd_chan }}, struct {{ app.cmd_struct }},
		 NULL, NULL, ZBUS_OBSERVERS_EMPTY, ZBUS_MSG_INIT(0));

ZBUS_CHAN_DEFINE({{ app.hk_chan }}, struct {{ app.hk_struct }},
		 NULL, NULL, ZBUS_OBSERVERS_EMPTY, ZBUS_MSG_INIT(0));

ZBUS_CHAN_DEFINE({{ app.status_chan }}, struct app_status,
		 NULL, NULL, ZBUS_OBSERVERS_EMPTY, ZBUS_MSG_INIT(0));
{% if app.wakeup %}

ZBUS_CHAN_DEFINE({{ app.wakeup_chan }}, struct frame_tick,
		 NULL, NULL, ZBUS_OBSERVERS_EMPTY, ZBUS_MSG_INIT(0));
{% endif %}
{% for d in app.data_channels %}

{{ d.description | comment }}
ZBUS_CHAN_DEFINE({{ d.name }}, struct {{ d.struct }},
		 NULL, NULL, ZBUS_OBSERVERS_EMPTY, ZBUS_MSG_INIT(0));
{% endfor %}

#if defined(CONFIG_ZBUS_MSG_SUBSCRIBER_BUF_ALLOC_STATIC)
/*
 * Every publish takes a buffer from the zbus pool, whether or not anyone
 * observes the channel, and zbus asserts if the message does not fit.
 * Catch that here instead of at run time.
 */
{% for chan, ctype in app.channels %}
BUILD_ASSERT(sizeof({{ ctype }}) <= CONFIG_ZBUS_MSG_SUBSCRIBER_NET_BUF_STATIC_DATA_SIZE,
	     "{{ chan }}: raise CONFIG_ZBUS_MSG_SUBSCRIBER_NET_BUF_STATIC_DATA_SIZE");
{% endfor %}
#endif
