# Kconfig for libraries shared by apps.

menu "SilverSat libraries"

config SS_BLAKE2S
	bool "BLAKE2s (vendored reference implementation)"
	help
	  The BLAKE2 reference implementation of BLAKE2s, used for command
	  signatures (DS-52).

config SS_CMD_AUTH
	bool "Command authentication"
	select SS_BLAKE2S
	help
	  Shape check and signature check for signed ground commands
	  (DS-50 stages 1 and 2, DS-52).

config SS_CMD_COUNTER
	bool "Command counter"
	help
	  Replay protection for signed ground commands: the counter check
	  and the per-key-slot floor (DS-50 stage 3, DS-53). The floor is
	  held in RAM until the FRAM service exists.

config SS_CMD_COUNTER_RAM_FLOORS
	bool
	default y if SS_CMD_COUNTER && !SS_COMMAND_INGEST
	help
	  The counter floors in RAM, for a build without command ingest,
	  which keeps them in FRAM (DS-53, DS-70).

config SS_CMD_DELIVER
	bool "Command delivery"
	depends on SS_MESSAGES
	help
	  Publishes a command to an app's command channel, keeping at most
	  CMD_MAX_PENDING unhandled commands from each sender so the zbus
	  pool stays within its budget (DS-07). Used by the generated ground
	  command routing and internal command senders.

config SS_CMD_TEXT
	bool "Command text"
	help
	  Splits ground command text into words and reads typed arguments.
	  Used by the generated command routing (DS-50).

config SS_EVENT
	bool "Events"
	depends on SS_MESSAGES
	help
	  The queue that carries events from every app to telemetry output,
	  which downlinks them (DS-10). Emitting never waits: a full queue
	  drops the new event and counts it.

config SS_EVENT_QUEUE_DEBUG
	bool "Send debug events to the ground"
	default y if !SS_FLIGHT_BUILD
	depends on SS_EVENT
	help
	  Queue events of severity debug for the downlink, like any other.
	  Off in the flight build, where debug events would spend the radio
	  link on development detail (common.yaml's severity); they are still
	  logged when SS_EVENT_LOG is on.

config SS_EVENT_LOG
	bool "Log each event on the console (development)"
	default y if !SS_FLIGHT_BUILD
	depends on SS_EVENT && LOG
	help
	  Each event is also logged as it is raised, so the bench sees it at
	  once. Not in the flight build (DS-06).

config SS_NVM
	bool "FRAM service"
	depends on SS_MESSAGES
	select CRC
	select EEPROM if $(dt_alias_enabled,fram)
	select RETAINED_MEM if $(dt_alias_enabled,nvm-mirror)
	help
	  Records that survive a reset, in FRAM through Zephyr's EEPROM
	  API: two slots per record with generation and CRC, and the
	  record's default whenever it can't be read (DS-70, DS-71,
	  DS-75). A board without the fram alias runs with FRAM
	  unavailable. Records marked mirror: are also kept in the
	  nvm-mirror retained memory (the STM32's backup SRAM).

config SS_LINK
	bool "Link frame queues"
	depends on SS_MESSAGES
	help
	  The static queues that carry raw link frames between the radio app
	  and the apps that use them (DS-11): uplink to command ingest, and
	  downlink to the radio.

config SS_LINK_CODEC
	bool "Link codec"
	select CRC
	help
	  Frames for the serial links to the peer boards: KISS framing,
	  CRC-32C, and sequence numbers (DS-33, DS-65, DS-66).

endmenu
