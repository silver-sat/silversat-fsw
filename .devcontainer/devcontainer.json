{
	"name": "SilverSat FSW (Zephyr)",

	"build": {
		"dockerfile": "Dockerfile",
		"options": ["--platform=linux/amd64"]
	},
	"runArgs": ["--platform=linux/amd64"],
	
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		// Joins the tailnet at start when the TS_AUTH_KEY Codespaces secret
		// is set, so `make flash` and `make console` reach the flatsat
		// (docs/flatsat.md, DS-04). Without the secret, nothing changes.
		"ghcr.io/tailscale/codespace/tailscale": {
			"version": "latest"
		}
	},

	// Assembles the west workspace. Runs during prebuild, so a Codespace
	// created from a prebuild opens ready to build.
	"onCreateCommand": "bash .devcontainer/setup.sh",

	"hostRequirements": {
		"cpus": 4,
		"storage": "32gb"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"marus25.cortex-debug",
				"nordic-semiconductor.nrf-devicetree",
				"nordic-semiconductor.nrf-kconfig",
				"redhat.vscode-yaml"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"files.associations": {
					"*.overlay": "dts",
					"*.dtsi": "dts",
					"*.conf": "properties"
				},
				"cmake.configureOnOpen": false
			}
		}
	},

	"remoteUser": "vscode"
}
