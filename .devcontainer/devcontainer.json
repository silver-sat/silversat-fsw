{
	"name": "SilverSat FSW (Zephyr)",

	"build": {
		"dockerfile": "Dockerfile"
	},

	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// Assembles the west workspace. Runs during prebuild, so a Codespace
	// created from a prebuild opens ready to build.
	"onCreateCommand": "bash .devcontainer/setup.sh",

	"hostRequirements": {
		"cpus": 4,
		"storage": "32gb"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"marus25.cortex-debug",
				"nordic-semiconductor.nrf-devicetree",
				"nordic-semiconductor.nrf-kconfig",
				"redhat.vscode-yaml"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"files.associations": {
					"*.overlay": "dts",
					"*.dtsi": "dts",
					"*.conf": "properties"
				},
				"cmake.configureOnOpen": false
			}
		}
	},

	"remoteUser": "vscode"
}
