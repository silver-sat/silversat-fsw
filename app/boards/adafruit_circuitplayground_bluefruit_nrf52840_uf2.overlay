/*
 * Application overlay for the Circuit Playground Bluefruit, the student
 * learning and exploration tier (DS-04, docs/cpb.md).
 *
 * The console is the board's USB serial port. The radio UART is on the TX
 * and RX pads, at SilverSat's 19200 baud: Zephyr's automatic USB setup
 * registers only one serial port, so it can't go over USB yet.
 *
 * The nRF52840 has no backup SRAM, so there is no nvm-mirror alias (DS-75):
 * with the FRAM fitted every record survives; without it none do.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	aliases {
		radio-uart = &uart0;
		/* The slide switch selects test mode, read once at boot (DS-42). */
		test-mode-signal = &slide_switch;
		/* The FRAM (DS-70), on i2c0 below. */
		fram = &fram;
		/* The on-board thermistor (DS-30). */
		temperature-sensor = &board_thermistor;
	};

	/*
	 * Thermistor to the supply, a 10 kOhm resistor to ground, and the ADC
	 * between them, on A9 (P0.31, AIN7). The table is for 10 kOhm at 25 C
	 * and a beta of 3950, the values Adafruit's own library uses, from
	 * Zephyr's scripts/utils/ntc_thermistor_table.py.
	 */
	board_thermistor: board-thermistor {
		compatible = "ntc-thermistor-generic";
		io-channels = <&adc 7>;
		pullup-ohm = <0>;
		pulldown-ohm = <10000>;
		connected-positive;
		zephyr,compensation-table = <(-25) 144316>, <(-15) 77898>, <(-5) 44026>,
					    <(5) 25924>, <(15) 15837>, <(25) 10000>,
					    <(35) 6505>, <(45) 4348>, <(55) 2978>,
					    <(65) 2086>, <(75) 1491>, <(85) 1086>,
					    <(95) 805>, <(105) 606>, <(115) 463>, <(125) 358>;
	};
};

/*
 * VDD/4 with a gain of 1/4 makes the ADC's full scale the supply, which the
 * thermistor's divider is ratioed against, so the supply's exact voltage
 * cancels out.
 */
&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_VDD_1_4";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};

&uart0 {
	current-speed = <19200>;
};

/* Neither board is documented as having pull-ups on these lines. */
&i2c0_default {
	group1 {
		bias-pull-up;
	};
};

/*
 * A 32 KB Fujitsu MB85RC256V on an Adafruit breakout (ID 1895), on the A4
 * (SCL) and A5 (SDA) pads. A part for learning, not the flight choice (DS-70).
 */
&i2c0 {
	fram: fram@50 {
		compatible = "fujitsu,mb85rcxx";
		reg = <0x50>;
		size = <32768>;
		pagesize = <32768>;
		address-width = <16>;
	};
};
