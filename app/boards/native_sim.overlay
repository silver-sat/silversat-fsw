/*
 * Application overlay for native_sim.
 *
 * The radio's UART (DS-07, DS-90) is uart1, which native_sim connects to a
 * pseudo-terminal. A Python simulator opens the PTY and plays the radio;
 * native_sim prints the PTY's path at startup ("uart_1 connected to
 * pseudotty: /dev/pts/N").
 *
 * When the magnetometer driver lands, this also gains an emulated SPI bus
 * with a mag node on it -- see tests/drivers/mag/app.overlay for the shape.
 */

/ {
	aliases {
		radio-uart = &uart1;
		test-mode-signal = &test_mode_signal;
		/*
		 * The FRAM (DS-70) is the board's simulated EEPROM, kept in a
		 * file (eeprom.bin), so records survive between runs.
		 */
		fram = &eeprom0;
	};

	/*
	 * The test signal (DS-42) is an emulated GPIO pin, active low. An
	 * emulated input reads low until something drives it, so the signal is
	 * present: `make run` boots into test mode, with the radio and command
	 * ingest running, instead of waiting out the separation delay.
	 */
	test_mode_signal: test-mode-signal {
		compatible = "silversat,test-mode-signal";
		gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
	};
};

&uart1 {
	status = "okay";
};
